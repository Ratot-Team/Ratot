# Safe placeholders only. Copy to .env and replace values locally.
PORT=3069
RATOT_ENV=dev

# Use the dedicated database and role for the selected environment.
DATABASE_URL_DEV=postgresql://ratot_discord_dev_user:REPLACE_DEV_PASSWORD@postgresql.home.arpa:5432/ratot_discord_dev
DATABASE_URL_PROD=postgresql://ratot_discord_prod_user:REPLACE_PROD_PASSWORD@postgresql.home.arpa:5432/ratot_discord_prod
POSTGRES_SSL_MODE=verify-full
POSTGRES_CA_CERT_PATH=/path/to/quartz-guardian-root-ca.crt

RATOT_CREATOR_DISCORD_ID=000000000000000001
RATOT_CREATOR_DISCORD_USERNAME=example_creator

RATOT_DEV_DISCORD_ID=000000000000000002
RATOT_PROD_DISCORD_ID=000000000000000003
RATOT_DEV_NAME="Ratot (Dev)"
RATOT_PROD_NAME="Ratot"
RATOT_DEV_TOKEN=REPLACE_DEV_TOKEN
RATOT_PROD_TOKEN=REPLACE_PROD_TOKEN

RATOT_GUILD_ID=000000000000000004
